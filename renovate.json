{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>tbouska/renovate-config", "customManagers:dockerfileVersions"],
  "mise": {
    "managerFilePatterns": ["**/assets/config/mise/config.toml"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/koolna-images-configmap\\.yaml$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+[A-Z_]+:\\s+\"[^\"]+:(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "mise's python is depName `python` but packageName `python/cpython`, so match on depName.",
      "matchDepNames": ["python"],
      "matchManagers": ["mise"],
      "groupName": "python"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["base/koolna-dev/assets/config/mise/config.toml"],
      "matchDepNames": ["!python"],
      "groupName": "koolna-dev mise tools"
    },
    {
      "description": "buvis-gems is our own package: give it a separate PR so a broken tool in the koolna-dev group cannot hold it back. Must stay after the koolna-dev group rule to override its groupName.",
      "matchManagers": ["mise"],
      "matchDepNames": ["pipx:buvis-gems"],
      "groupName": "buvis-gems"
    },
    {
      "description": "pylast >=7.1 needs httpx2, whose httpcore2 conflicts with Debian's apt-owned h11 in the mopidy image (pip backtracks into a broken build). Keep it below 7.1 until Debian's httpcore/h11 move; see apps/mopidy/requirements.txt.",
      "matchFileNames": ["apps/mopidy/requirements.txt"],
      "matchDepNames": ["pylast"],
      "allowedVersions": "<7.1.0"
    },
    {
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apiserver",
        "k8s.io/component-base",
        "sigs.k8s.io/controller-runtime"
      ],
      "matchManagers": ["gomod"],
      "groupName": "kubernetes",
      "allowedVersions": "<0.36.0"
    }
  ]
}
