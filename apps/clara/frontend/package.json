{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.1.0",
		"@tailwindcss/vite": "4.2.4",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.3.1",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "25.6.0",
		"jsdom": "30.1.3",
		"svelte": "5.57.3",
		"svelte-check": "4.4.7",
		"tailwindcss": "4.2.4",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.5"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.0"
	}
}
